{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/care/north-star-md/shop",
      "has": [{ "type": "host", "value": "joinnorthstarmd.com" }],
      "missing": [
        { "type": "query", "key": "brand" },
        { "type": "query", "key": "brandId" }
      ],
      "destination": "/care/north-star-md/shop?brand=north-star-md&brandId=c8e7f6a2-4b1d-4e9f-a3c2-1d5e8f7a6b4c",
      "permanent": false
    },
    {
      "source": "/care/north-star-md/shop",
      "has": [{ "type": "host", "value": "www.joinnorthstarmd.com" }],
      "missing": [
        { "type": "query", "key": "brand" },
        { "type": "query", "key": "brandId" }
      ],
      "destination": "/care/north-star-md/shop?brand=north-star-md&brandId=c8e7f6a2-4b1d-4e9f-a3c2-1d5e8f7a6b4c",
      "permanent": false
    },
    {
      "source": "/diagnostics",
      "destination": "/explore-treatments",
      "permanent": true
    },
    {
      "source": "/membership",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/resources",
      "destination": "/",
      "permanent": false
    }
  ],
