  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/care/:path*",
      "has": [{ "type": "host", "value": "joinnorthstarmd.com" }],
      "destination": "https://www.peak-health.io/care/:path*"
    },
    {
      "source": "/care/:path*",
      "has": [{ "type": "host", "value": "www.joinnorthstarmd.com" }],
      "destination": "https://www.peak-health.io/care/:path*"
    }
  ]
}
