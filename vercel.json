{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "joinnorthstarmd.com" }],
      "destination": "https://www.peak-health.io/care/north-star-md/shop?brand=north-star-md&brandId=c8e7f6a2-4b1d-4e9f-a3c2-1d5e8f7a6b4c"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.joinnorthstarmd.com" }],
      "destination": "https://www.peak-health.io/care/north-star-md/shop?brand=north-star-md&brandId=c8e7f6a2-4b1d-4e9f-a3c2-1d5e8f7a6b4c"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "joinnorthstarmd.com" }],
      "destination": "https://www.peak-health.io/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.joinnorthstarmd.com" }],
      "destination": "https://www.peak-health.io/:path*"
    }
  ]
}
